# Postgres connection (matches docker-compose db service defaults)
DATABASE_URL=postgresql://display:display@db:5432/home_display

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Comma-separated GitHub usernames allowed to log in
ADMIN_GITHUB_LOGINS=

# HMAC key for session cookies (generate a random string)
SESSION_SECRET=change-me

# Public URL of this app (used for OAuth callback)
APP_BASE_URL=http://localhost:3100
